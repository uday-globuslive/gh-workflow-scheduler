# Copy to .env and fill in. Never commit the real .env file.

# Random string used to sign session cookies, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Web UI login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# GitHub token(s) used to trigger workflows (fine-grained PAT with "Actions: Read and write").
# Jobs reference a variable by name; extra tokens must start with GITHUB_TOKEN, e.g. GITHUB_TOKEN_OTHERORG.
GITHUB_TOKEN=
# GITHUB_TOKEN_OTHERORG=
# GITHUB_API_URL=https://api.github.com   # change for GitHub Enterprise Server

# Azure DevOps Services YAML pipelines: PAT with Build: Read & execute; the PAT
# identity also needs permission to queue the target pipeline. Enter the variable
# name in the job, not the PAT. Additional names must start with AZURE_DEVOPS_PAT.
AZURE_DEVOPS_PAT=
# AZURE_DEVOPS_PAT_OTHERORG=
# AZURE_DEVOPS_API_URL=https://dev.azure.com
# Classic pipelines and Azure DevOps Server are outside the verified scope.
# Template parameters are stored in the database; do not put secrets in them.

# Storage. SQLite file by default; use PostgreSQL to share jobs across several instances:
# DATABASE_URL=postgresql+psycopg://user:pass@dbhost/cronweb
# Install the matching database driver separately (e.g. psycopg[binary] for the URL above).
DATABASE_URL=sqlite:///cronweb.db

DEFAULT_TIMEZONE=UTC
HOST=0.0.0.0
PORT=8080

# Set to false on instances that should only serve the UI.
SCHEDULER_ENABLED=true
TICK_SECONDS=15
# Runs missed by more than this (e.g. server was down) are recorded as skipped instead of fired.
MISFIRE_GRACE_SECONDS=3600
# Set to true when served over HTTPS.
SECURE_COOKIES=false
LOG_LEVEL=INFO
